<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Emit generated files to disk for inspection -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <!-- Reference the Blake source generator package -->
  <ItemGroup>
    <PackageReference Include="Blake.SourceGenerator" Version="0.1.17" />
  </ItemGroup>

  <!-- .blake files are automatically included as AdditionalFiles by the props -->
  <ItemGroup>
    <AdditionalFiles Include="**\*.blake" />
  </ItemGroup>

</Project>
